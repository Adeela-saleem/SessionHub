# ── Database ────────────────────────────────────────────────
POSTGRES_USER=sessionhub
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=sessionhub
POSTGRES_PORT=5432

# ── API ─────────────────────────────────────────────────────
NODE_ENV=production
API_PORT=4000
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:8080

# ── AI (Groq — free tier at https://console.groq.com) ───────
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ── Web ─────────────────────────────────────────────────────
WEB_PORT=8080
VITE_API_URL=http://localhost:4000

# Optional: raise the blanket API rate limit (requests/min) for local demos.
# Leave unset in production (defaults to 120).
# THROTTLE_LIMIT=600
